plugin.tx_ps14teaser {
	view {
		layoutRootPaths {
			10 = EXT:ps14_teaser/Resources/Private/Layouts/
			20 = EXT:ps14_site/Resources/Private/Extensions/Teaser/Layouts/
		}

		templateRootPaths {
			10 = EXT:ps14_teaser/Resources/Private/Templates/
			20 = EXT:ps14_site/Resources/Private/Extensions/Teaser/Templates/
		}

		partialRootPaths {
			10 = EXT:ps14_teaser/Resources/Private/Partials/
			20 = EXT:ps14_site/Resources/Private/Extensions/Teaser/Partials/
			30 = EXT:ps14_foundation/Resources/Private/Partials/
			40 = EXT:ps14_site/Resources/Private/Partials/
		}
	}

	persistence {
		storagePid = {$plugin.tx_ps14teaser.persistence.storagePid}
		#recursive = 1
	}

	features {
		#skipDefaultArguments = 1
		# if set to 1, the enable fields are ignored in BE context
		ignoreAllEnableFieldsInBe = 0
	}

	mvc {
		#callDefaultActionIfActionCantBeResolved = 1
	}

	settings {
		badgeParentCategories = {$plugin.tx_ps14teaser.settings.badgeParentCategories}
		readmoreLimit = 3

		media {
			aside {
				width = 720
				cropVariant = desktop
				mediaQueries {
					992 {
						width = 560
						cropVariant = desktop
						mediaQuery = (min-width: 992px)
					}
					768 {
						width = 450
						cropVariant = desktop
						mediaQuery = (min-width: 768px)
					}
					576 {
						width = 720
						cropVariant = mobile
						mediaQuery = (min-width: 576px)
					}
					0 {
						width = 545
						cropVariant = mobile
						mediaQuery = (min-width: 0px)
					}
				}
			}

			card {
				width = 530
				cropVariant = desktop
				mediaQueries {
					576 {
						width = 360
						cropVariant = desktop
						mediaQuery = (min-width: 576px)
					}
					0 {
						width = 530
						cropVariant = mobile
						mediaQuery = (min-width: 0px)
					}
				}
			}
		}

		plugin {
			layouts {
				default = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.layout.default
				aside = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.layout.aside
			}

			abstractType {
				default = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.abstract-type.default
				long = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.abstract-type.long
			}

			asideAlignment {
				left = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.aside-alignment.left
				right = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.aside-alignment.right
			}

			asideMediaSize {
				default = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.aside-media-size.default
				small = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.aside-media-size.small
			}

			textAlignment {
				default = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.text-alignment.default
				center = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.text-alignment.center
			}

			subpagesLayout {
				default = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.subpages-layout.default
				columns = LLL:EXT:ps14_teaser/Resources/Private/Language/locallang_plugin.xlf:flexform.field.subpages-layout.columns
			}
		}
	}
}

tt_content.list.dataProcessing {
	200 {
		ps14teaser_frontend {
			importCss {
				10 = /assets/css/modules/teaser.css
			}
		}
	}

	210 = Ps14\Teaser\DataProcessing\TeaserProcessor
}

module.tx_ps14teaser.settings < plugin.tx_ps14teaser.settings

block.teaserSubNavigation = HMENU
block.teaserSubNavigation {
	special = directory
	special.value.field = parent

	1 = TMENU
	1 {
		wrap = <ul>|</ul>

		NO {
			wrapItemAndSub = <li>|</li>
			ATagBeforeWrap = 1
			linkWrap = <span>|</span>
		}
	}
}